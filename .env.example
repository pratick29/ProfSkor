# Copy to .env (never commit .env). Only SUPABASE_* are needed for accounts and history.

# Supabase (Project Settings -> API). The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: GitHub token (no scopes needed) for real contribution data and 5,000 req/hour instead of 60
GITHUB_TOKEN=

# Optional: enables AI resume review; without it the rule-based review is used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated extra frontend origins, e.g. https://profskor.vercel.app
CORS_ORIGINS=

# Requests per minute per client, and number of reverse proxies in front of the API (1 on Render)
RATE_LIMIT=60
TRUSTED_PROXY_HOPS=0

# Seconds to cache GitHub/LeetCode lookups
CACHE_TTL_SECONDS=3600

# Optional: lets scripts call /admin/metrics with an X-Admin-Secret header
ADMIN_API_SECRET=

# Optional: salt for anonymous e-resume visitor IDs (any long random string). Defaults to one derived from the service role key.
VIEW_HASH_SALT=
